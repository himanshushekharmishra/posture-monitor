# Copy to .env in the project root to override settings on this machine only
# (.env is gitignored). Any top-level key in config/settings.json works, in
# upper case. Real environment variables win over .env, for example:
#   $env:CAMERA_INDEX = "1"; python -m src.main --debug
CAMERA_INDEX=0
MODEL_PATH=models/pose_landmarker_lite.task
# PROCESS_FPS=5
# PERSIST_SECONDS=30

# ---- Web accounts (python -m backend) ----
# Secrets belong here, never in config/settings.json.
# The address people use to reach the web app; OAuth redirects come back here.
# Use https:// when the app is reachable from other machines (cookies become Secure).
# WEB_PUBLIC_URL=http://127.0.0.1:8000

# Sign in with Google: console.cloud.google.com > APIs & Services > Credentials >
# Create OAuth client ID (Web application). Redirect URI:
#   http://127.0.0.1:8000/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign in with GitHub: github.com/settings/developers > New OAuth App.
# Callback URL: http://127.0.0.1:8000/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Phone codes. "console" prints codes in the server window (local testing only);
# "twilio" sends real SMS; "off" hides phone sign-in.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567

# GUEST_TRIAL_DAYS=14
# AUTH_SESSION_DAYS=7
