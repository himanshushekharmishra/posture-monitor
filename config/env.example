# Copy to .env in the project root to override settings on this machine only
# (.env is gitignored). Any top-level key in config/settings.json works, in
# upper case. Real environment variables win over .env, for example:
#   $env:CAMERA_INDEX = "1"; python -m src.main --debug
CAMERA_INDEX=0
MODEL_PATH=models/pose_landmarker_lite.task
